{
  "name": "sritrang-ocr",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "BABEL_DISABLE_CACHE=1 npx babel-node -r dotenv/config ./src/server.js",
    "dev-win": "cross-env BABEL_DISABLE_CACHE=1 npx babel-node -r dotenv/config ./src/server.js",
    "dev-watch": "concurrently \"npm:watch-node\" \"npm:watch-css\"",
    "watch-node": "nodemon -r dotenv/config --exec \"npx babel-node ./src/server.js\"",
    "watch-css": "tailwindcss -i ./src/assets/css/styles.css -o ./public/css/styles.min.css --watch",
    "build": "npm run build-css && npm run build-js && node build.js",
    "build-js": "babel src --out-dir dist",
    "build-css": "tailwindcss -i ./src/assets/css/styles.css -o ./public/css/styles.min.css --minify",
    "build-css-fallback": "node -e \"const fs=require('fs'); fs.copyFileSync('./src/assets/css/styles.css', './public/css/styles.min.css')\"",
    "start": "node dist/server.js",
    "migrate": "npx babel-node ./src/migrate.js",
    "pip": "pip3 install -r requirements.txt"
  },
  "devDependencies": {
    "@babel/cli": "^7.1.2",
    "@babel/core": "^7.7.7",
    "@babel/node": "^7.7.7",
    "@babel/plugin-transform-runtime": "^7.1.0",
    "@babel/preset-env": "^7.9.5",
    "babel-eslint": "^10.0.1",
    "babel-plugin-inline-import": "^3.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "daisyui": "^4.10.5",
    "eslint": "^6.1.0",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-config-prettier": "^6.5.0",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "pm2": "^5.3.0",
    "prettier": "^2.0.4",
    "tailwindcss": "^3.4.3"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.22.15",
    "archiver": "^7.0.1",
    "body-parser": "^1.20.2",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "ioredis": "^5.3.2",
    "kill-process-by-name": "^1.0.5",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2"
  },
  "author": "",
  "license": "ISC"
}



